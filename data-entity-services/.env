# .env
DB_NAME=spriced_nrp
DRIVER=org.postgresql.Driver
DB_USERNAME=postgres
DB_PASSWORD=mysecretpassword
DB_HOST=host.docker.internal
DB_PORT=5432
DB_IDLETIMEOUT=30000
DB_MAXLIFETIME=1800000
DB_CONNECTIONTIMEOUT=30000
DB_MAXPOOLSIZE=10
DB_MINPOOLSIZE=1
KEEP_ALIVE=10000
DB_SCHEMA=test
application_port=8085
application_ip=http://spriced-application
