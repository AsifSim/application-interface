# .env
DB_NAME=agent_dev
DRIVER=org.postgresql.Driver
DB_USERNAME=postgres
DB_PASSWORD=mysecretpassword
DB_HOST=localhost

DB_PORT=5401
DB_IDLETIMEOUT=30000
DB_MAXLIFETIME=1800000
DB_CONNECTIONTIMEOUT=1800000
DB_MAXPOOLSIZE=100
DB_MINPOOLSIZE=1
DB_CONNECTION_LEAK_THRESHOLD=10000
KEEP_ALIVE=10000
