# .env
DRIVER=org.postgresql.Driver
DB_IDLETIMEOUT=30000
DB_MAXLIFETIME=1800000
DB_CONNECTIONTIMEOUT=30000
DB_MAXPOOLSIZE=30
DB_MINPOOLSIZE=1
DB_CONNECTION_LEAK_THRESHOLD=10000
KEEP_ALIVE=10000
DB_APPLICATION_NAME=tml
DB_SCHEMA=public
LOG_DIR=C:/sim
HOME_DIR=/home/user/spriced-platform-data-management-layer
CONNECTION_TIMEOUT=5000
READ_TIMEOUT=60000
BATCH_SIZE=500
platform_1.0=true
PLATFORM_TML_PORT_REST=8882
PLATFORM_TML_PORT_GRPC=9095
PLATFORM_TML_GRPC_MAX_POOLSIZE=30
PLATFORM_TML_GRPC_THREADS=50
PLATFORM_AUTH_CONFIG_FILE=auth-config.json
TRANSIENT_STORAGE_PATH=C:/sim
APPLICATION_GRPC_SERVER_ADDRESS=static://localhost:9099
PLATFORM_TML_ADDRESS_GRPC=static://localhost:9095
APPLICATION_GRPC_SERVER_PORT=9099
APPLICATION_REST_SERVER_PORT=8087
EXCEL_SECURITY_ALGORITHM=AES
EXCEL_SECURITY_SECRET=MySecretKey123
EXCEL_SHEET_PASSWORD=SheetPass@123

EXCEL_GENERATED_FILE_OUTPUT_PATH=C:/Logs/excel-files/
OUTBOUND_PROCESSING_PATH=C:/Logs/excel-files/Inbound_Processing
OUTBOUND_FAILD_PATH=C:/Logs/excel-files/Validation_Failed

SHEETPASSWORD=password123

AWS_ACCESS_KEY_ID=
AWS_SECRET_KEY=
AWS_REGION=us-east-2
EMAIL_FROM=spriced-analytics@simadvisory.com

EMAIL_SUBJECT_VALIDATION_FAILED=Excel Upload Validation Failed
EMAIL_BODY_VALIDATION_FAILED=<h3>Validation Failed</h3><p>File: {fileName}</p><p>Invalid rows count: {invalidCount}</p>
EMAIL_MESSAGE_MAIL_SENT=Validation Errors Found. Email sent.
EMAIL_MESSAGE_MAIL_FAILED=Validation Errors Found. Email sending failed!

WORKFLOW_ORCHESTRATOR_BASE_URL=http://localhost:5089/workflow
WORKFLOW_ORCHESTRATOR_RUN_PATH=/run
WORKFLOW_ORCHESTRATOR_WORKFLOWNAME=regional_file_genrater
APP_CALL_METHOD=false
platform_1=true
grpc.server.port=-1
auth.config.file=auth-config.json
grpc.client.Platform-client.negotiationType=plaintext
TML_METHOD_CALL=false
TML_CONTAINER=true
APPLICATION_CONTAINER=true


INVALID_CELL_COLOR=RED
MANDATORY_COLUMN_COLOR=GREY_25_PERCENT
VALID_MODIFIED_CELL_COLOR=ORANGE
LOCKED_COLUMNS_COLOR=WHITE
HEADER_COLOR=GREY_25_PERCENT
EDITABLE_COLUMN_COLOR=LEMON_CHIFFON
RATE_LIMITING_DB_THREADS=10

ENABLE_AUTH=false

ATTRIBUTE_PROPERTY_OVERRIDE=true
