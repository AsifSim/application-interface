EMAIL_MESSAGE_MAIL_SENT=Validation Errors Found. Email sent.
EMAIL_MESSAGE_MAIL_FAILED=Validation Errors Found. Email sending failed!

WORKFLOW_ORCHESTRATOR_BASE_URL=http://localhost:5089/workflow
WORKFLOW_ORCHESTRATOR_RUN_PATH=/run
WORKFLOW_ORCHESTRATOR_WORKFLOWNAME=regional_file_genrater
APP_CALL_METHOD=true
platform_1=true
