HOME_DIR=/home/user/spriced-platform-data-management-layer
CONNECTION_TIMEOUT=50000000
READ_TIMEOUT=600000000
BATCH_SIZE=5000
platform_1.0=true
PLATFORM_TML_PORT_REST=8880
